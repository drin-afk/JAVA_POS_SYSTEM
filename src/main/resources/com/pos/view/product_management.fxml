<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Product Management (Laboratory 8) -->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pos.controller.ProductManagementController"
            styleClass="app-bg"
            prefWidth="1050.0"
            prefHeight="660.0">

    <stylesheets>
        <URL value="@pos.css"/>
    </stylesheets>

    <!-- TOP HEADER -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14.0">
            <padding>
                <Insets top="16.0" right="28.0" bottom="16.0" left="28.0"/>
            </padding>
            <Label text="PS" styleClass="brand-badge" alignment="CENTER"
                   minWidth="44.0" minHeight="44.0" style="-fx-font-size: 15px;"/>
            <VBox spacing="2.0">
                <Label text="PRODUCT MANAGEMENT" styleClass="page-title"/>
                <Label text="Maintain product catalog, pricing, inventory stock, and availability." styleClass="page-crumb"/>
            </VBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <!-- LEFT FORM PANEL -->
            <VBox styleClass="panel-card" spacing="6.0" prefWidth="320.0" minWidth="320.0">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <Label text="Product Information" styleClass="section-title"/>
                <Region minHeight="4.0"/>

                <Label text="Product Code" styleClass="field-label"/>
                <TextField fx:id="txtProductCode" styleClass="pos-field" promptText="Example: P001"/>

                <Label text="Product Name" styleClass="field-label"/>
                <TextField fx:id="txtProductName" styleClass="pos-field" promptText="Product name"/>

                <Label text="Category" styleClass="field-label"/>
                <TextField fx:id="txtCategory" styleClass="pos-field" promptText="Example: Beverage / Bread"/>

                <Label text="Price" styleClass="field-label"/>
                <TextField fx:id="txtPrice" styleClass="pos-field" promptText="0.00"/>

                <Label text="Quantity" styleClass="field-label"/>
                <TextField fx:id="txtQuantity" styleClass="pos-field" promptText="0"/>

                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="cmbStatus" styleClass="pos-combo" maxWidth="Infinity"/>

                <Region minHeight="6.0"/>

                <HBox spacing="8.0">
                    <Button text="Add" styleClass="small-primary" onAction="#handleAdd"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                    <Button text="Update" styleClass="secondary-button" onAction="#handleUpdate"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                </HBox>
                <HBox spacing="8.0">
                    <Button text="Deactivate" styleClass="danger-button" onAction="#handleDeactivate"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                    <Button text="Clear" styleClass="ghost-button" onAction="#handleClear"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                </HBox>

                <Label fx:id="lblMessage" text="" styleClass="message-text"
                       wrapText="true" minHeight="36.0"/>
            </VBox>

            <!-- RIGHT TABLE PANEL -->
            <VBox styleClass="panel-card" spacing="10.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <!-- Search and Action Toolbar -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" styleClass="pos-field"
                               promptText="Search code, name, or category"
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Search" styleClass="secondary-button" onAction="#handleSearch"
                            prefHeight="36.0"/>
                    <!-- Exercise 1: Clear Search button -->
                    <Button text="Clear Search" styleClass="ghost-button" onAction="#handleClearSearch"
                            prefHeight="36.0"/>
                    <Button text="Refresh" styleClass="ghost-button" onAction="#handleRefresh"
                            prefHeight="36.0"/>
                    <!-- Exercise 4: Low Stock search button -->
                    <Button text="Low Stock (≤ 5)" styleClass="secondary-button" onAction="#handleLowStock"
                            prefHeight="36.0" style="-fx-font-weight: bold;"/>
                </HBox>

                <!-- TableView -->
                <TableView fx:id="tblProducts" styleClass="pos-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" minWidth="45.0" prefWidth="55.0" maxWidth="65.0"/>
                        <TableColumn fx:id="colCode" text="Code" minWidth="70.0" prefWidth="85.0" maxWidth="100.0"/>
                        <TableColumn fx:id="colName" text="Product Name" prefWidth="180.0"/>
                        <TableColumn fx:id="colCategory" text="Category" minWidth="90.0" prefWidth="110.0"/>
                        <!-- Exercise 5: Price displayed with two decimal places -->
                        <TableColumn fx:id="colPrice" text="Price" minWidth="80.0" prefWidth="90.0"/>
                        <TableColumn fx:id="colQuantity" text="Qty" minWidth="55.0" prefWidth="65.0" maxWidth="80.0"/>
                        <TableColumn fx:id="colStatus" text="Status" minWidth="75.0" prefWidth="85.0" maxWidth="100.0"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
