<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- User Management (Laboratory 7) - same pastry shop design as the login and dashboard. -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pos.controller.UserManagementController"
            styleClass="app-bg"
            prefWidth="1000.0"
            prefHeight="650.0">

    <stylesheets>
        <URL value="@pos.css"/>
    </stylesheets>

    <!-- TOP HEADER -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14.0">
            <padding>
                <Insets top="16.0" right="28.0" bottom="16.0" left="28.0"/>
            </padding>
            <Label text="PS" styleClass="brand-badge" alignment="CENTER"
                   minWidth="44.0" minHeight="44.0" style="-fx-font-size: 15px;"/>
            <VBox spacing="2.0">
                <Label text="User Management" styleClass="page-title"/>
                <Label text="Add, update, and deactivate POS user accounts." styleClass="page-crumb"/>
            </VBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets top="22.0" right="28.0" bottom="22.0" left="28.0"/>
            </padding>

            <!-- USER FORM -->
            <VBox styleClass="panel-card" spacing="6.0" prefWidth="320.0" minWidth="320.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="User Information" styleClass="section-title"/>
                <Region minHeight="6.0"/>

                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField" styleClass="pos-field" promptText="Enter username"/>

                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="pos-field"
                               promptText="Min. 6 characters for new users"/>

                <Label text="Full Name" styleClass="field-label"/>
                <TextField fx:id="fullNameField" styleClass="pos-field" promptText="Enter full name"/>

                <Label text="Role" styleClass="field-label"/>
                <ComboBox fx:id="roleComboBox" styleClass="pos-combo" maxWidth="Infinity"
                          promptText="Select a role"/>

                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusComboBox" styleClass="pos-combo" maxWidth="Infinity"/>

                <Region minHeight="6.0"/>

                <HBox spacing="8.0">
                    <Button text="ADD" styleClass="small-primary" onAction="#handleAdd"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                    <Button text="UPDATE" styleClass="secondary-button" onAction="#handleUpdate"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                </HBox>
                <HBox spacing="8.0">
                    <Button text="DEACTIVATE" styleClass="danger-button" onAction="#handleDeactivate"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                    <Button text="CLEAR" styleClass="ghost-button" onAction="#handleClear"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36.0"/>
                </HBox>

                <Label fx:id="messageLabel" text="" styleClass="message-text"
                       wrapText="true" minHeight="36.0"/>
            </VBox>

            <!-- USER TABLE -->
            <VBox styleClass="panel-card" spacing="12.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <!-- Title row with the Exercise 2 Active User Counter on the right -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="User Accounts" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="activeCountLabel" text="Active accounts: 0" styleClass="counter-badge"/>
                </HBox>

                <!-- Exercise 1: Search Users (filters by username or full name) -->
                <TextField fx:id="searchField" styleClass="pos-field"
                           promptText="Search by username or full name..."/>

                <TableView fx:id="userTable" styleClass="pos-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" minWidth="40.0" prefWidth="50.0" maxWidth="60.0"/>
                        <TableColumn fx:id="usernameColumn" text="Username" prefWidth="120.0"/>
                        <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="180.0"/>
                        <TableColumn fx:id="roleColumn" text="Role" minWidth="80.0" prefWidth="90.0" maxWidth="110.0"/>
                        <TableColumn fx:id="statusColumn" text="Status" minWidth="80.0" prefWidth="90.0" maxWidth="100.0"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>

