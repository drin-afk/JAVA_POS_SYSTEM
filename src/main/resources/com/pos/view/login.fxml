<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pastry shop login screen. Same fx:id and onAction names as the manual:
     usernameField, passwordField, loginButton, messageLabel, #handleLogin -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pos.controller.LoginController"
      prefWidth="760"
      prefHeight="460"
      style="-fx-background-color: #fdf3e7;">

    <!-- LEFT: shop branding panel -->
    <VBox alignment="CENTER"
          spacing="14"
          prefWidth="300"
          minWidth="300"
          style="-fx-background-color: linear-gradient(to bottom, #8a4b12, #5e3009);">
        <padding>
            <Insets top="30" right="28" bottom="30" left="28"/>
        </padding>

        <!-- Round "logo" badge -->
        <Label text="PS"
               alignment="CENTER"
               minWidth="88"
               minHeight="88"
               style="-fx-background-color: #fdf3e7; -fx-background-radius: 44;
                      -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #8a4b12;"/>

        <!-- Change this text to your shop's name -->
        <Label text="PASTRY SHOP"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Label text="Point of Sale System"
               style="-fx-font-size: 14px; -fx-text-fill: #f3d9b8;"/>

        <Region minHeight="2"
                maxWidth="60"
                style="-fx-background-color: #d9a066;"/>

        <Label text="Pandesal  •  Ensaymada&#10;Ube Cheese Roll  •  Buko Pie&#10;Brazo de Mercedes  •  Coffee"
               wrapText="true"
               textAlignment="CENTER"
               style="-fx-font-size: 12px; -fx-text-fill: #f3d9b8;"/>

        <Label text="Fresh from the oven, every day."
               style="-fx-font-size: 12px; -fx-font-style: italic; -fx-text-fill: #d9a066;"/>
    </VBox>

    <!-- RIGHT: login form -->
    <VBox alignment="CENTER"
          spacing="10"
          prefWidth="460"
          minWidth="460">
        <padding>
            <Insets top="30" right="50" bottom="30" left="50"/>
        </padding>

        <Label text="Welcome back"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5e3009;"/>

        <Label text="Sign in to start your shift"
               style="-fx-font-size: 13px; -fx-text-fill: #8a6a4b;"/>

        <Region minHeight="8"/>

        <VBox spacing="6" maxWidth="330" alignment="CENTER_LEFT">
            <Label text="Username"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5e3009;"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       prefHeight="38"
                       style="-fx-background-color: white; -fx-background-radius: 6;
                              -fx-border-color: #d9b48a; -fx-border-radius: 6; -fx-font-size: 14px;"/>

            <Region minHeight="4"/>

            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5e3009;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefHeight="38"
                           style="-fx-background-color: white; -fx-background-radius: 6;
                                  -fx-border-color: #d9b48a; -fx-border-radius: 6; -fx-font-size: 14px;"/>
              <Label fx:id="messageLabel"
       text=""
       wrapText="true"
       alignment="CENTER"
       textAlignment="CENTER"
       maxWidth="330"
       minHeight="36"
       style="-fx-font-size: 12px; -fx-text-fill: #b00020;"/>
        </VBox>

               <HBox spacing="10" maxWidth="330">
            <Button fx:id="loginButton"
                    text="LOGIN"
                    onAction="#handleLogin"
                    defaultButton="true"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #8a4b12; -fx-background-radius: 6; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
         
            
       <Button fx:id="clearButton"
        text="CLEAR"
        onAction="#handleClear"
        prefWidth="100"
        prefHeight="42"
        style="-fx-background-color: #8a4b12; -fx-background-radius: 6; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
       />
           
        </HBox>
    </VBox>
</HBox>
