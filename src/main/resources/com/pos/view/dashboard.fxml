<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pastry shop dashboard: same brown / cream design as the login screen. -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pos.controller.DashboardController"
            prefWidth="900.0"
            prefHeight="600.0"
            style="-fx-background-color: #fdf3e7;">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16.0"
              style="-fx-background-color: linear-gradient(to right, #8a4b12, #5e3009);">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>

            <!-- Round "logo" badge -->
            <Label text="PS"
                   alignment="CENTER"
                   minWidth="60.0"
                   minHeight="60.0"
                   style="-fx-background-color: #fdf3e7; -fx-background-radius: 30;
                          -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #8a4b12;"/>

            <VBox spacing="3.0">
                <!-- Change this text to your shop's name -->
                <Label text="PASTRY SHOP"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label fx:id="welcomeLabel"
                       text="Welcome"
                       style="-fx-font-size: 15px; -fx-text-fill: white;"/>

                <Label fx:id="userInfoLabel"
                       text="User Information"
                       style="-fx-font-size: 12px; -fx-text-fill: #f3d9b8;"/>

                <!-- Exercise 1: current date -->
                <Label fx:id="dateLabel"
                       text="Date"
                       style="-fx-font-size: 12px; -fx-text-fill: #d9a066;"/>
            </VBox>
        </HBox>
    </top>

    <!-- LEFT MENU -->
    <left>
        <VBox spacing="10.0"
              prefWidth="260.0"
              style="-fx-background-color: #f6e4cf;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="MENU"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8a6a4b;"/>

            <Button text="POS / SALES"
                    onAction="#openSales"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="PRODUCTS"
                    onAction="#openProducts"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <!-- Exercise 3: INVENTORY button below Products -->
            <Button text="INVENTORY"
                    onAction="#openInventory"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="USERS"
                    onAction="#openUsers"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="TRANSACTION HISTORY"
                    onAction="#openHistory"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="REPORTS"
                    onAction="#openReports"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #5e3009; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-color: #d9b48a; -fx-border-radius: 6;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="LOGOUT"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: #8a4b12; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="CENTER"
              spacing="15.0">
            <Label text="DASHBOARD"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #8a4b12;"/>

            <Label text="Select a module from the menu."
                   style="-fx-font-size: 14px; -fx-text-fill: #5e3009;"/>

            <Label text="The modules will be completed in the next laboratories."
                   style="-fx-text-fill: #8a6a4b;"/>
        </VBox>
    </center>

    <!-- Exercise 2: FOOTER -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: #5e3009;">
            <padding>
                <Insets top="8.0" right="10.0" bottom="8.0" left="10.0"/>
            </padding>
            <Label text="DCIT 26   |   Basic POS System"
                   style="-fx-font-size: 11px; -fx-text-fill: #f3d9b8;"/>
        </HBox>
    </bottom>
</BorderPane>
